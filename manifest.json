{
  "manifestVersion": 2,
  "id": "com.zync.editor.zedit",
  "name": "Zedit",
  "version": "0.1.0",
  "description": "A fast, full-featured code editor powered by Monaco.",
  "author": "Zync Team",
  "publisher": "com.zync",
  "license": "MIT",
  "homepage": "https://github.com/zync-sh/zync-editor-monaco-plugin",
  "support": "https://github.com/zync-sh/zync-editor-monaco-plugin/issues",
  "engines": {
    "zync": ">=2.33.9",
    "pluginApi": "^2.0.0"
  },
  "permissions": {
    "required": [
      {
        "id": "editor.provider.register",
        "reason": "Open and edit files in Zync's editor area."
      }
    ]
  },
  "type": "editor-provider",
  "editor": {
    "entry": "editor.html",
    "displayName": "Zedit",
    "priority": 200,
    "defaultFor": ["text/*"],
    "supports": [
      "search",
      "replace",
      "goto-line",
      "syntax-highlight",
      "folding",
      "multi-selection",
      "completion",
      "hover",
      "definition",
      "minimap",
      "save"
    ]
  }
}
